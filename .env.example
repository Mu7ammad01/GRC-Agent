# PostgreSQL (base GRC)
POSTGRES_USER=grc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=grc
DATABASE_URL=postgresql://grc:change-me@localhost:5432/grc

# Chroma (base vectorielle)
