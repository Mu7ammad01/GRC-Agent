# PostgreSQL (base GRC)
POSTGRES_USER=grc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=grc
DATABASE_URL=postgresql://grc:change-me@localhost:5432/grc

# Chroma (base vectorielle)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=corpus_grc

# Ollama (LLM local et embeddings — les embeddings restent toujours locaux)
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# LLM de l'agent : ollama (local, défaut) | anthropic | openai | google_genai
LLM_PROVIDER=ollama
LLM_MODEL=mistral:7b
# Exemples (vérifier le nom exact du modèle dans la documentation du fournisseur) :
#   LLM_PROVIDER=ollama     LLM_MODEL=qwen2.5:7b
#   LLM_PROVIDER=anthropic  LLM_MODEL=claude-sonnet-5
#   LLM_PROVIDER=openai     LLM_MODEL=<nom du modèle OpenAI>
#   LLM_PROVIDER=google_genai LLM_MODEL=<nom du modèle Gemini>

# Clés d'API (uniquement pour les fournisseurs cloud ; ne jamais committer .env)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
